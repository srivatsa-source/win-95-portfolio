# Environment Variables for Ora Chatbot Backend

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Server Configuration
PORT=3000

# CORS Configuration (comma-separated allowed origins)
# For development: http://localhost:5500,http://127.0.0.1:5500
# For production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional: Rate Limiting (requests per minute)
RATE_LIMIT=60
